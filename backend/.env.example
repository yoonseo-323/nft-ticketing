PORT=3000
JWT_SECRET=your_jwt_secret_here

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/nft_ticketing

# 개인키 암호화 키 (32바이트 hex, openssl rand -hex 32 로 생성)
ENCRYPTION_KEY=your_32_byte_hex_key_here

# Hardhat 로컬 노드
RPC_URL=http://127.0.0.1:8545

# contracts 배포 후 deploy.js 출력값 복사
OWNER_PRIVATE_KEY=0x...
IDENTITY_REGISTRY_ADDRESS=0x...
TICKET_NFT_ADDRESS=0x...
TICKET_MARKET_ADDRESS=0x...
